{
    "Comment": "NYC Taxi Lakehouse End-to-End Pipeline Orchestration",
    "StartAt": "RunBronzeToSilverJob",
    "States": {
        "RunBronzeToSilverJob": {
            "Type": "Task",
            "Resource": "arn:aws:states:::glue:startJobRun.sync",
            "Parameters": {
                "JobName": "nyc-taxi-bronze-to-silver",
                "Arguments": {
                    "--S3_BUCKET_NAME": "nyc-taxi-lakehouse-6709616681"
                }
            },
            "Retry": [
                {
                    "ErrorEquals": [
                        "Glue.ResourceNumberLimitExceededException",
                        "States.Timeout"
                    ],
                    "IntervalSeconds": 30,
                    "MaxAttempts": 2,
                    "BackoffRate": 2.0
                }
            ],
            "Catch": [
                {
                    "ErrorEquals": [
                        "States.ALL"
                    ],
                    "Next": "PipelineFailed"
                }
            ],
            "Next": "RunSilverToGoldJob"
        },
        "RunSilverToGoldJob": {
            "Type": "Task",
            "Resource": "arn:aws:states:::glue:startJobRun.sync",
            "Parameters": {
                "JobName": "silver_to_gold",
                "Arguments": {
                    "--S3_BUCKET_NAME": "nyc-taxi-lakehouse-6709616681"
                }
            },
            "Catch": [
                {
                    "ErrorEquals": [
                        "States.ALL"
                    ],
                    "Next": "PipelineFailed"
                }
            ],
            "Next": "RefreshAthenaPartitions"
        },
        "RefreshAthenaPartitions": {
            "Type": "Task",
            "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
            "Parameters": {
                "QueryString": "MSCK REPAIR TABLE nyc_taxi_db.gold_monthly_kpi;",
                "QueryExecutionContext": {
                    "Database": "nyc_taxi_db"
                },
                "ResultConfiguration": {
                    "OutputLocation": "s3://nyc-taxi-athena-results-67/"
                }
            },
            "Catch": [
                {
                    "ErrorEquals": [
                        "States.ALL"
                    ],
                    "Next": "PipelineFailed"
                }
            ],
            "Next": "PipelineSucceeded"
        },
        "PipelineSucceeded": {
            "Type": "Succeed"
        },
        "PipelineFailed": {
            "Type": "Fail",
            "Cause": "Pipeline failed during Glue or Athena task execution.",
            "Error": "PipelineExecutionError"
        }
    }
}