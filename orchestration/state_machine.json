{
  "Comment": "NYC TLC lakehouse: per-month Ingest -> Silver -> Gold, then DimZone. ${...} values are CloudFormation DefinitionSubstitutions.",
  "StartAt": "ProcessMonths",
  "States": {
    "ProcessMonths": {
      "Type": "Map",
      "ItemsPath": "$.months",
      "MaxConcurrency": ${MaxConcurrency},
      "ItemSelector": {
        "year_month.$": "$$.Map.Item.Value",
        "taxi_types.$": "States.JsonToString($.taxi_types)"
      },
      "ItemProcessor": {
        "ProcessorConfig": {"Mode": "INLINE"},
        "StartAt": "Ingest",
        "States": {
          "Ingest": {
            "Type": "Task",
            "Resource": "arn:aws:states:::glue:startJobRun.sync",
            "Parameters": {
              "JobName": "${IngestJob}",
              "Arguments": {"--YEAR_MONTH.$": "$.year_month", "--TAXI_TYPES.$": "$.taxi_types"}
            },
            "TimeoutSeconds": 3600,
            "Retry": [{"ErrorEquals": ["Glue.ConcurrentRunsExceededException", "Glue.AWSGlueException", "States.TaskFailed"], "IntervalSeconds": 60, "MaxAttempts": 2, "BackoffRate": 2}],
            "ResultPath": null,
            "Next": "Silver"
          },
          "Silver": {
            "Type": "Task",
            "Resource": "arn:aws:states:::glue:startJobRun.sync",
            "Parameters": {
              "JobName": "${SilverJob}",
              "Arguments": {"--YEAR_MONTH.$": "$.year_month", "--TAXI_TYPES.$": "$.taxi_types"}
            },
            "TimeoutSeconds": 3600,
            "Retry": [{"ErrorEquals": ["Glue.ConcurrentRunsExceededException", "Glue.AWSGlueException", "States.TaskFailed"], "IntervalSeconds": 60, "MaxAttempts": 2, "BackoffRate": 2}],
            "ResultPath": null,
            "Next": "Gold"
          },
          "Gold": {
            "Type": "Task",
            "Resource": "arn:aws:states:::glue:startJobRun.sync",
            "Parameters": {
              "JobName": "${GoldJob}",
              "Arguments": {"--YEAR_MONTH.$": "$.year_month"}
            },
            "TimeoutSeconds": 1800,
            "Retry": [{"ErrorEquals": ["Glue.ConcurrentRunsExceededException", "Glue.AWSGlueException", "States.TaskFailed"], "IntervalSeconds": 60, "MaxAttempts": 2, "BackoffRate": 2}],
            "ResultPath": null,
            "End": true
          }
        }
      },
      "ResultPath": null,
      "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "NotifyFailure"}],
      "Next": "DimZone"
    },
    "DimZone": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {"JobName": "${DimZoneJob}"},
      "TimeoutSeconds": 1800,
      "Retry": [{"ErrorEquals": ["Glue.ConcurrentRunsExceededException", "Glue.AWSGlueException", "States.TaskFailed"], "IntervalSeconds": 60, "MaxAttempts": 2, "BackoffRate": 2}],
      "ResultPath": null,
      "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "NotifyFailure"}],
      "Next": "PipelineSucceeded"
    },
    "NotifyFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${AlertTopicArn}",
        "Subject": "NYC taxi pipeline failed",
        "Message.$": "States.JsonToString($.error)"
      },
      "Next": "PipelineFailed"
    },
    "PipelineSucceeded": {"Type": "Succeed"},
    "PipelineFailed": {"Type": "Fail", "Error": "PipelineExecutionError", "Cause": "See SNS alert / execution history for the failing month and job."}
  }
}
